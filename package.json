{
  "name": "islet",
  "version": "0.5.2",
  "description": "A Dynamic Island for Windows: now-playing, alerts and Claude Code activity",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/server.test.js && node test/calendar.test.js && node test/notifications.test.js && node test/cliphistory.test.js && node test/teams.test.js && node test/sports.test.js && node test/apifootball.test.js && node test/spotify.test.js && node test/claudehooks.test.js && node test/main.smoke.test.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "private": true,
  "author": "Islet",
  "build": {
    "appId": "com.islet.app",
    "productName": "Islet",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test/**",
      "!dist/**",
      "!.github/**",
      "!*.bat",
      "!*.vbs",
      "!assets/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Islet",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "Islet-Setup.exe"
    }
  }
}
